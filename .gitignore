# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# Database (generated at runtime, not source code)
*.db
*.sqlite
*.sqlite3

# Scan output files
data/*.json
!data/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Environment secrets
# ⚠ `.env` is ignored; `.env.example` is NOT — that asymmetry is deliberate.
# The example documents which variables exist, with safe placeholder values,
# so a new contributor knows what to fill in. The real file never leaves the
# machine it was written on.
.env
.env.local
.env.*.local
deploy/.env
!.env.example
!deploy/.env.example

# Personal teaching notes — kept locally, not published
docs/*.md

# Linter / formatter caches
.ruff_cache/