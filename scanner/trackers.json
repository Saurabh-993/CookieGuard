  "generic_patterns": [
    {
      "pattern": "^(php|jsp|asp)?[-_]?sess(ion)?[-_]?id$",
      "match": "regex",
      "category": "necessary",
      "vendor": "Generic",
      "purpose": "Matches session-identifier naming conventions such as sessionid, session_id, sess_id."
    },
    {
      "pattern": "^(_|x-)?csrf[-_]?(token)?$",
      "match": "regex",
      "category": "necessary",
      "vendor": "Generic",
      "purpose": "Cross-Site Request Forgery token. A security control, so consent-exempt."
    },
    {
      "pattern": "^xsrf[-_]token$",
      "match": "regex",
      "category": "necessary",
      "vendor": "Generic",
      "purpose": "CSRF token as named by Angular, Laravel and similar frameworks."
    },
    {
      "pattern": "^(cart|basket)([-_]?id)?$",
      "match": "regex",
      "category": "necessary",
      "vendor": "Generic",
      "purpose": "Shopping cart contents. Explicitly named as consent-exempt in EU regulator guidance."
    },
    {
      "pattern": "^(csrf|auth|login|user)[-_]?token$",
      "match": "regex",
      "category": "necessary",
      "vendor": "Generic",
      "purpose": "Authentication token needed to keep a user logged in."
    },
    {
      "pattern": "^(lang|language|locale|country|region)$",
      "match": "regex",
      "category": "functional",
      "vendor": "Generic",
      "purpose": "Stores the user's chosen language or region."
    },
    {
      "pattern": "^(theme|dark[-_]?mode|color[-_]?scheme|font[-_]?size)$",
      "match": "regex",
      "category": "functional",
      "vendor": "Generic",
      "purpose": "Stores a display preference such as dark mode."
    },
    {
      "pattern": "^(currency|timezone|tz)$",
      "match": "regex",
      "category": "functional",
      "vendor": "Generic",
      "purpose": "Stores a localisation preference."
    },
    {
      "pattern": "^(cookie[-_]?consent|consent[-_]?(given|state|status)|gdpr)$",
      "match": "regex",
      "category": "necessary",
      "vendor": "Generic",
      "purpose": "Records the user's consent choice. Necessary, because you must remember a refusal in order to honour it."
    }
  ]
