# ============================================================================
# CookieGuard — production environment (Phase 7)
# ============================================================================
#
# ON THE SERVER:
#     cd ~/cookieguard/deploy
#     cp .env.example .env
#     nano .env          # fill in the two values below
#
# ⚠ `.env` is gitignored. This example is committed. Never put a real secret
#    in this file — it is public.
# ============================================================================


# --- Your hostname ----------------------------------------------------------
# The name Caddy will request a TLS certificate for. It MUST already resolve
# to this server's public IP before you start the stack.
#
# Free option — DuckDNS:  https://duckdns.org  (sign in with GitHub, pick a
#   name, paste your EC2 public IP). Gives you <name>.duckdns.org at no cost.
#
# Paid option — a .xyz domain is about $2/year and looks better on a CV. Point
#   an A record at the same IP.
#
# NO scheme, NO trailing slash, NO port. Just the hostname.
SITE_ADDRESS=cookieguard.duckdns.org

# The same thing WITH the scheme. Used for CORS_ORIGINS, which is compared as
# an exact string — so `https://` and no trailing slash, or it matches nothing
# and the browser only tells you "blocked".
SITE_URL=https://cookieguard.duckdns.org


# --- Which image to run -----------------------------------------------------
# Built and pushed by GitHub Actions. Lowercase — container registries reject
# uppercase in image paths, and GitHub usernames are often capitalised, which
# catches nearly everyone once.
#
# `:latest` is fine to start. For a real deployment, pin the commit SHA:
#     GHCR_IMAGE=ghcr.io/saurabh-993/cookieguard:9f2c1a4e...
# Then rollback is editing this one line and re-running deploy.sh, and you can
# always answer "what exactly is running right now?"
GHCR_IMAGE=ghcr.io/saurabh-993/cookieguard:latest


# --- Optional ---------------------------------------------------------------
# Only if a scan legitimately needs longer than two minutes.
# MAX_SCAN_SECONDS=120

# ⚠ Leave this alone. docker-compose.prod.yml grants SYS_ADMIN so Chromium
# keeps its sandbox. Setting this to true disables a real security boundary
# while we point a browser at URLs typed by strangers on the public internet —
# which is a much worse idea in production than it was on your laptop.
# BROWSER_NO_SANDBOX=false
