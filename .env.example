# ============================================================================
# CookieGuard — example environment file
# ============================================================================
#
# HOW TO USE
#     cp .env.example .env        (Windows:  copy .env.example .env)
#     ...then edit .env
#
# ⚠ `.env` is in .gitignore. `.env.example` is NOT, and that asymmetry is the
# whole point of this file:
#
#     .env          real values      never committed
#     .env.example  the SHAPE        always committed
#
# Without the example, a new contributor clones the repo and has no way to
# know which variables exist — the knowledge lives only in whoever set up the
# server. With it, `diff` against your .env tells you what you're missing.
#
# Rule: when you add a variable to config.py, add it here with a SAFE
# placeholder in the same commit. Never a real secret — this file is public.
# ============================================================================


# --- Which deployment is this? ----------------------------------------------
# Informational only; shown on /api/health so you can tell at a glance whether
# you're looking at staging or production.
ENVIRONMENT=development


# --- Database ---------------------------------------------------------------
# Path to the SQLite file. Inside Docker this must point at the mounted
# volume (/data), or the database is destroyed every time the container is
# replaced.
#   local:   ./data/cookieguard.db     (the default — leave unset)
#   docker:  /data/cookieguard.db
# COOKIEGUARD_DB=/data/cookieguard.db


# --- Network ----------------------------------------------------------------
# 127.0.0.1 = reachable only from this machine. Correct for a laptop.
# 0.0.0.0   = reachable on every network interface. REQUIRED inside a
#             container, because "localhost" inside a container means the
#             container itself — bind to 127.0.0.1 there and `-p 8000:8000`
#             appears to do nothing at all.
COOKIEGUARD_HOST=127.0.0.1
COOKIEGUARD_PORT=8000


# --- CORS -------------------------------------------------------------------
# Comma-separated list of origins allowed to call this API from a browser.
# An origin is scheme + host + port, with NO trailing slash:
#     ✅ https://cookieguard.example
#     ❌ https://cookieguard.example/        (trailing slash — never matches)
#     ❌ cookieguard.example                 (no scheme — never matches)
#
# Note: when the dashboard is served by this same API (it is, at /dashboard)
# the browser sees one origin and CORS never applies. These entries matter
# only if you host the frontend separately, e.g. on S3 or Netlify.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Emergency escape hatch — allows ANY website to call this API.
# Setting CORS_ORIGINS=* does NOT work (it's matched as a literal string),
# so this explicit flag exists to stop people losing an hour to that.
# Leave it false unless you are demoing on a throwaway host.
CORS_ALLOW_ALL=false


# --- Browser sandbox --------------------------------------------------------
# Disables Chromium's process sandbox. Only needed on platforms where the
# container can't be granted the capabilities Chromium wants.
#
# ⚠ This is a real security reduction — we point the browser at URLs typed by
# strangers, which is precisely what the sandbox defends against. Our
# docker-compose.yml keeps the sandbox ON by granting SYS_ADMIN instead.
# See scanner/scan.py :: browser_launch_args() for the full explanation.
BROWSER_NO_SANDBOX=false


# --- Limits -----------------------------------------------------------------
# A scan drives a real browser: seconds of CPU and hundreds of MB of RAM.
# Without a ceiling, one person holding down a button can exhaust a small
# instance. Phase 7 targets a t2.micro, so this is not theoretical.
MAX_SCAN_SECONDS=120
